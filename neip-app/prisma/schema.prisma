generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Exoneree {
  id                       Int                    @id @default(autoincrement())
  personalInfoId           Int                    @unique
  caseInfoId               Int                    @unique
  legalInfoId              Int                    @unique
  wrongfulConvictionInfoId Int                    @unique
  postExonerationInfoId    Int                    @unique
  metaDataId               Int                    @unique
  caseInfo                 CaseInfo               @relation(fields: [caseInfoId], references: [id])
  legalInfo                LegalInfo              @relation(fields: [legalInfoId], references: [id])
  metaData                 MetaData               @relation(fields: [metaDataId], references: [id])
  personalInfo             PersonalInfo           @relation(fields: [personalInfoId], references: [id])
  postExonerationInfo      PostExonerationInfo    @relation(fields: [postExonerationInfoId], references: [id])
  wrongfulConvictionInfo   WrongfulConvictionInfo @relation(fields: [wrongfulConvictionInfoId], references: [id])
}

model PersonalInfo {
  id          Int       @id @default(autoincrement())
  name        String
  dateOfBirth String
  gender      Gender
  race        String
  ethnicity   String
  phoneNumber String?
  address     String?
  email       String?   @unique
  imageURL    String?
  exoneree    Exoneree?
}

model CaseInfo {
  id                Int       @id @default(autoincrement())
  caseNumber        String?   @unique
  yearsInPrison     Int?
  arrestDate        String?
  convictionDate    String?
  freedomDate       String?
  exonerationDate   String?
  crimeType         String?
  sentence          String?
  country           String?
  state             String?
  jurisdiction      String?
  exonerationNumber Int?
  exoneree          Exoneree?
}

model LegalInfo {
  id                  Int       @id @default(autoincrement())
  convictionMethod    String[]
  exonerationMethod   String
  legalRepresentation String?
  prosecutor          String?
  officersInvolved    String[]
  originalCharges     String[]
  judge               String?
  exoneree            Exoneree?
}

model WrongfulConvictionInfo {
  id                          Int       @id @default(autoincrement())
  falseConfession             Boolean?
  eyewitnessMisidentification Boolean?
  inadequateLegalDefense      Boolean?
  forensicEvidence            Boolean?
  informantTestimony          Boolean?
  otherInfo                   String?
  policeMisconduct            Boolean?
  prosecutorialMisconduct     Boolean?
  exoneree                    Exoneree?
}

model PostExonerationInfo {
  id                 Int       @id @default(autoincrement())
  reentrySupport     String[]
  publicApology      Boolean?
  compensationAmount Int?
  currentCountry     String?
  currentState       String?
  occupation         String?
  compensationDate   DateTime?
  exoneree           Exoneree?
}

model AdditionalInfo {
  id                    Int      @id @default(autoincrement())
  mediaCoverage         String
  advocacyInvolvement   String?
  educationalBackground String?
  healthInfo            String?
}

model MetaData {
  id          Int       @id @default(autoincrement())
  dataSource  String?
  lastUpdated String?
  createdAt   String?
  exoneree    Exoneree?
}

model ChargesDropdownOption {
  id    Int    @id @default(autoincrement())
  value String @unique
}

model OfficersDropdownOption {
  id    Int    @id @default(autoincrement())
  value String @unique
}

model JurisdictionDropdownOption {
  id    Int    @id @default(autoincrement())
  value String @unique
}

model Officer {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  notes      String?
  MediaLinks String?
}

enum Gender {
  M
  F
  OTHER
}
