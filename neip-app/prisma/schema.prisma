generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Exoneree {
  id                       Int                    @id @default(autoincrement())
  personalInfoId           Int                    @unique
  caseInfoId               Int                    @unique
  legalInfoId              Int                    @unique
  wrongfulConvictionInfoId Int                    @unique
  postExonerationInfoId    Int                    @unique
  metaDataId               Int                    @unique
  caseInfo                 CaseInfo               @relation(fields: [caseInfoId], references: [id])
  legalInfo                LegalInfo              @relation(fields: [legalInfoId], references: [id])
  metaData                 MetaData               @relation(fields: [metaDataId], references: [id])
  personalInfo             PersonalInfo           @relation(fields: [personalInfoId], references: [id])
  postExonerationInfo      PostExonerationInfo    @relation(fields: [postExonerationInfoId], references: [id])
  wrongfulConvictionInfo   WrongfulConvictionInfo @relation(fields: [wrongfulConvictionInfoId], references: [id])
}

model PersonalInfo {
  id          Int       @id @default(autoincrement())
  name        String
  dateOfBirth String
  gender      Gender
  race        String
  ethnicity   String
  phoneNumber String
  address     String
  email       String    @unique
  exoneree    Exoneree?
}

model CaseInfo {
  id              Int       @id @default(autoincrement())
  caseNumber      String    @unique
  jurisdictionId  Int       
  yearsInPrison   Int
  arrestDate      String
  convictionDate  String
  freedomDate     String
  exonerationDate String
  crimeType       String
  sentence        String
  state           String
  country         String
  exoneree        Exoneree?
}

model LegalInfo {
  id                  Int       @id @default(autoincrement())
  originalCharges     String
  convictionMethod    String[]
  exonerationMethod   String[]
  legalRepresentation String
  prosecutor          String
  detectivesInvolved  String[]
  exoneree            Exoneree?
}

model WrongfulConvictionInfo {
  id                            Int       @id @default(autoincrement())
  falseConfession               Boolean
  eyewitnessMisidentification   Boolean
  inadequateLegalDefense        Boolean
  policeProsecutorialMisconduct Boolean
  forensicEvidence              Boolean
  informantTestimony            Boolean
  exoneree                      Exoneree?
}

model PostExonerationInfo {
  id                 Int       @id @default(autoincrement())
  reentrySupport     String[]
  publicApology      Boolean
  compensationAmount Int
  compensationDate   String
  occupation         String
  currentState       String
  currentCountry     String
  exoneree           Exoneree?
}

model AdditionalInfo {
  id                    Int      @id @default(autoincrement())
  mediaCoverage         String[]
  advocacyInvolvement   String
  educationalBackground String
  healthInfo            String
}

model MetaData {
  id          Int       @id @default(autoincrement())
  dataSource  String
  lastUpdated String
  createdAt   String
  exoneree    Exoneree?
}

enum Gender {
  M
  F
  OTHER
}
