generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Exoneree {
  id                       Int                    @id @default(autoincrement())
  personalInfoId           Int                    @unique
  caseInfoId               Int                    @unique
  legalInfoId              Int                    @unique
  wrongfulConvictionInfoId Int                    @unique
  postExonerationInfoId    Int                    @unique
  metaDataId               Int                    @unique
  caseInfo                 CaseInfo               @relation(fields: [caseInfoId], references: [id])
  legalInfo                LegalInfo              @relation(fields: [legalInfoId], references: [id])
  metaData                 MetaData               @relation(fields: [metaDataId], references: [id])
  personalInfo             PersonalInfo           @relation(fields: [personalInfoId], references: [id])
  postExonerationInfo      PostExonerationInfo    @relation(fields: [postExonerationInfoId], references: [id])
  wrongfulConvictionInfo   WrongfulConvictionInfo @relation(fields: [wrongfulConvictionInfoId], references: [id])
}

model Location {
  id            Int             @id @default(autoincrement())
  state         String
  country       String
  caseInfo      CaseInfo?
  currentStatus CurrentStatus[]
}

model Compensation {
  id                  Int                  @id @default(autoincrement())
  amount              Int
  Date                DateTime
  postExonerationInfo PostExonerationInfo?
}

model CurrentStatus {
  id                  Int                  @id @default(autoincrement())
  occupation          String
  residenceId         Int
  residence           Location             @relation(fields: [residenceId], references: [id])
  postExonerationInfo PostExonerationInfo?
}

model PersonalInfo {
  id          Int       @id @default(autoincrement())
  name        String
  dateOfBirth DateTime
  gender      Gender
  race        String
  ethnicity   String
  phoneNumber String
  address     String
  email       String
  exoneree    Exoneree?
}

model CaseInfo {
  id              Int       @id @default(autoincrement())
  caseNumber      String
  jurisdictionId  Int       @unique
  yearsInPrison   Int
  arrestDate      DateTime
  convictionDate  DateTime
  freedomDate     DateTime
  exonerationDate DateTime
  crimeType       String
  sentence        String
  jurisdiction    Location  @relation(fields: [jurisdictionId], references: [id])
  exoneree        Exoneree?
}

model LegalInfo {
  id                  Int       @id @default(autoincrement())
  originalCharges     String
  convictionMethod    String[]
  exonerationMethod   String[]
  legalRepresentation String
  prosecutor          String
  detectivesInvolved  String[]
  exoneree            Exoneree?
}

model WrongfulConvictionInfo {
  id                            Int       @id @default(autoincrement())
  falseConfession               Boolean
  eyewitnessMisidentification   Boolean
  inadequateLegalDefense        Boolean
  policeProsecutorialMisconduct Boolean
  forensicEvidence              Boolean
  informantTestimony            Boolean
  exoneree                      Exoneree?
}

model PostExonerationInfo {
  id              Int           @id @default(autoincrement())
  compensationId  Int           @unique
  reentrySupport  String[]
  publicApology   Boolean
  currentStatusId Int           @unique
  exoneree        Exoneree?
  compensation    Compensation  @relation(fields: [compensationId], references: [id])
  currentStatus   CurrentStatus @relation(fields: [currentStatusId], references: [id])
}

model AdditionalInfo {
  id                    Int      @id @default(autoincrement())
  mediaCoverage         String[]
  advocacyInvolvement   String
  educationalBackground String
  healthInfo            String
}

model MetaData {
  id          Int       @id @default(autoincrement())
  dataSource  String
  lastUpdated DateTime
  createdAt   DateTime
  exoneree    Exoneree?
}

enum Gender {
  M
  F
  OTHER
}
